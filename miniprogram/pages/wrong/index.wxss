.tabs { padding: 16rpx 24rpx; gap: 12rpx; flex-wrap: wrap; }
.center { text-align: center; padding: 80rpx 0; }
.stem-preview { line-height: 1.5; }
.detail { border-top: 2rpx solid #e5e5ea; margin-top: 16rpx; padding-top: 16rpx; }
.option { border: 2rpx solid transparent; border-radius: 12rpx; padding: 12rpx; display: flex; margin-top: 8rpx; }
.option.right { border-color: #34c759; background: rgba(52, 199, 89, 0.1); }
.opt-label { font-weight: 600; margin-right: 12rpx; }
.fb-title { font-weight: 600; }
.stem { line-height: 1.6; }
